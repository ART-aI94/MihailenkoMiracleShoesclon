<Page x:Class="MihailenkoMiracleShoes.ProductPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:MihailenkoMiracleShoes"
      mc:Ignorable="d"
      Title="Чудо Обувь"
      FontFamily="Comic Sans MS">


    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="45"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#CFF5E5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">

                    <TextBlock Text="Поиск:"
                               FontSize="18"
                               VerticalAlignment="Center"/>

                    <TextBox Name="SearchingTB"
                             Width="160"
                             Height="28"
                             Margin="10,0"
                             TextChanged="SearchingTB_TextChanged"/>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">

                    <TextBlock Text="Категория:"
                               FontSize="18"
                               VerticalAlignment="Center"/>

                    <ComboBox Name="FilteringCB"
                              Width="150"
                              Height="28"
                              Margin="10,0"
                              SelectionChanged="FilteringCB_SelectionChanged"/>
                </StackPanel>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">

                    <TextBlock Text="Цена:"
                               FontSize="18"
                               VerticalAlignment="Center"/>
                    <StackPanel Margin="10,0">
                        <RadioButton Name="SortUp"
                                     Content="Дороже"
                                     Checked="SortUp_Checked"/>
                        <RadioButton Name="SortDown"
                                     Content="Дешевле"
                                     Checked="SortDown_Checked"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="3"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center">

                    <TextBlock Name="FIOTB"
                               FontSize="12"
                               HorizontalAlignment="Center"/>

                    <TextBlock Name="RoleTB"
                               FontSize="12"
                               HorizontalAlignment="Center"/>

                    <TextBlock Name="TBCount"
                               FontSize="14"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"/>

                </StackPanel>
            </Grid>
        </Border>

        <ListView Name="ProductList"
                  Grid.Row="1"
                  Margin="10"
                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  ScrollViewer.CanContentScroll="True">

            <ListView.ItemTemplate>

                <DataTemplate>

                    <Border Margin="5"
                            Padding="10"
                            Height="150"
                            BorderBrush="Gray"
                            BorderThickness="1"
                            CornerRadius="5">

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="120"/>
                            </Grid.ColumnDefinitions>
                            <Image Grid.Column="0"
                                   Width="110"
                                   Height="110"
                                   Stretch="Uniform"
                                   Source="{Binding Images}"/>

                            <StackPanel Grid.Column="1"
                                        Margin="10,0">

                                <TextBlock Text="{Binding ProductName}"
                                           FontSize="20"
                                           FontWeight="Bold"
                                           TextWrapping="Wrap"/>

                                <TextBlock TextWrapping="Wrap"
                                           MaxHeight="45">
                                    <Run Text="Описание: "/>
                                    <Run Text="{Binding Discription}"/>
                                </TextBlock>

                                <TextBlock>
                                    <Run Text="Категория: "/>
                                    <Run Text="{Binding Category.CategoryName}"/>
                                </TextBlock>

                                <TextBlock TextWrapping="Wrap">
                                    <Run Text="Состав: "/>
                                    <Run Text="{Binding Compound}"/>
                                </TextBlock>
                            </StackPanel>
                            <TextBlock Grid.Column="2"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"
                                       FontSize="18"
                                       FontWeight="Bold">
                                <Run Text="{Binding Price}"/>
                                <Run Text=" ₽"/>
                            </TextBlock>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <Border Grid.Row="2"
                Background="#CFF5E5">

            <Button Name="LogOutButton"
                    Content="Выйти"
                    HorizontalAlignment="Left"
                    Margin="20,0"
                    Click="LogOutButton_Click"/>
        </Border>
    </Grid>
</Page>